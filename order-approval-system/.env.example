# ── 鼎捷 T100 ERP 对接配置 ──
# 复制本文件为 .env.local 并填入实际值后，系统自动切换为 ERP 真实数据；
# 不配置时系统以内置演示数据运行，所有功能可正常体验。

# T100 ESP 网关地址（必填）
T100_BASE_URL=https://erp.example.com:8080

# 网关签发的 API Token（必填，向 ERP 管理员申请）
T100_API_TOKEN=

# 企业编号
T100_ENTERPRISE_NO=99

# 营运据点（工厂别）
T100_SITE=SW01

# 订单查询服务名（按贵司 ESP 网关实际注册的服务名调整）
T100_QUERY_SERVICE=sales.order.approval.query

# 审批回写服务名（按贵司 ESP 网关实际注册的服务名调整）
T100_WRITEBACK_SERVICE=sales.order.approval.update
