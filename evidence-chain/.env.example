# 数据库连接
DATABASE_URL="postgresql://evidence_user:evidence_pass@localhost:5432/evidence_chain?schema=public"

# NextAuth 配置
NEXTAUTH_URL="http://evidence.seekwave.internal"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production-min-32-chars"

# MinIO 配置
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET="evidence-docs"

# 应用配置
APP_NAME="证据链系统"
APP_URL="http://evidence.seekwave.internal"
MAX_FILE_SIZE="52428800"
