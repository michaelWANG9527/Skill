# ============================================
# 证据链系统环境配置
# 默认配置零依赖：SQLite 数据库 + 本地文件存储
# 只需 Node.js 即可运行，无需 Docker
# ============================================

# 数据库连接
# 默认 SQLite（文件数据库，开箱即用）：
DATABASE_URL="file:./prisma/dev.db"
# 生产环境 PostgreSQL（需配合 prisma/schema.postgresql.prisma 重新 generate）：
# DATABASE_URL="postgresql://evidence_user:evidence_pass@localhost:5432/evidence_chain?schema=public"

# NextAuth 配置（生产环境务必更换 SECRET：openssl rand -base64 32）
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-only-secret-please-change-in-production-32chars"

# 文件存储驱动：local（本地目录，默认） | minio（对象存储，生产）
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage"

# MinIO 配置（仅 STORAGE_DRIVER=minio 时生效）
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="evidence-docs"

# 鼎捷 T100 ERP 服务端集成（订单同步 API 的鉴权密钥）
# 留空则关闭 /api/erp/* 接口；生产环境用 openssl rand -hex 32 生成
ERP_API_KEY=""

# 应用配置
APP_NAME="证据链系统"
APP_URL="http://localhost:3000"
MAX_FILE_SIZE="52428800"
